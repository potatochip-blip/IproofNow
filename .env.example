# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Database --------------------------------------------------------------
# docker-compose Postgres (default):
DATABASE_URL=postgresql://iproof:proof123@localhost:5432/iproofnow?schema=public

# Local Postgres 16 alternative (skip docker-compose Postgres):
# DATABASE_URL=postgresql://postgres:proof123@localhost:5432/iproofnow?schema=public

# Tests REQUIRE a separate database whose name ends in _test (safety guard):
DATABASE_URL_TEST=postgresql://iproof:proof123@localhost:5432/iproofnow_test?schema=public

# --- Sessions / Cookies ----------------------------------------------------
# Used as additional entropy mixed into audit metadata; rotate freely.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=change-me-32-bytes-of-random-hex

# --- CORS ------------------------------------------------------------------
# Comma-separated list of additional allowed frontend origins (localhost:3000 always allowed).
FRONTEND_ORIGIN=

# --- S3 / MinIO ------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=iproof
S3_SECRET_KEY=proof123
S3_BUCKET=iproofnow-files
