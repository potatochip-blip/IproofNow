# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Database --------------------------------------------------------------
# docker-compose Postgres (default):
DATABASE_URL=postgresql://iproof:proof123@localhost:5432/iproofnow?schema=public

# Local Postgres 16 alternative (skip docker-compose Postgres):
# DATABASE_URL=postgresql://postgres:proof123@localhost:5432/iproofnow?schema=public

# Tests REQUIRE a separate database whose name ends in _test (safety guard):
DATABASE_URL_TEST=postgresql://iproof:proof123@localhost:5432/iproofnow_test?schema=public

# --- Sessions / Cookies ----------------------------------------------------
# Used as additional entropy mixed into audit metadata; rotate freely.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=change-me-32-bytes-of-random-hex

# --- Audit chain signing (Phase 6) -----------------------------------------
# 32-byte (64 hex char) HMAC key. lib/audit-sig.ts fails fast at module load
# when this is missing or malformed outside NODE_ENV=test. Treat rotation as
# a planned event: a key change invalidates all existing signatures, so the
# rotation procedure should re-sign rows under the new key (and verify each
# row's existing signature first to confirm no tampering pre-rotation).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_SIGNING_KEY=change-me-32-bytes-of-random-hex

# --- CORS ------------------------------------------------------------------
# Comma-separated list of additional allowed frontend origins (localhost:3000 always allowed).
FRONTEND_ORIGIN=

# --- S3 / MinIO ------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=iproof
S3_SECRET_KEY=proof123
S3_BUCKET=iproofnow-files

# --- OpenTimestamps anchoring (Phase 7) ------------------------------------
# Comma-separated calendar server URLs. The `proof.anchor` job submits the
# proof digest to all of them in parallel; anchoring succeeds when at least
# one accepts. These are the public Bitcoin mainnet calendars — submitting
# the same digest to several is the standard redundancy practice.
OTS_CALENDAR_URLS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org,https://finney.calendar.eternitywall.com

# Esplora-shaped Bitcoin block explorer, used by anchor/verify (and the
# upgrade job, best-effort) to confirm a block exists at the attested
# height. Swap in a self-hosted Esplora to avoid trusting a third party.
BITCOIN_EXPLORER_URL=https://blockstream.info/api
