// iProofNow Prisma schema — Phase 0
// Source of truth: Full_Backend_Developer_Brief §16.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  INDIVIDUAL
  COMPANY
  LAWYER
  LAW_ENFORCEMENT
  GOVERNMENT
  ADMIN
}

enum ProofStatus {
  DRAFT
  SEALED
}

enum Visibility {
  PRIVATE
  PUBLIC
  ORG
}

enum PackageStatus {
  PENDING
  READY
  FAILED
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum HashStatus {
  PENDING
  COMPLETE
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

// Phase 7: ProofAnchor lifecycle.
//   STUB      — pre-Phase-7 placeholder (deterministic sha256(proofId)).
//   PENDING   — digest submitted to OTS calendars; partial proof stored,
//               awaiting a Bitcoin-confirmed receipt.
//   CONFIRMED — calendar returned a Bitcoin block attestation; otsProof
//               holds the full receipt.
//   FAILED    — upgrade never confirmed within the 7-day cap.
enum AnchorStatus {
  STUB
  PENDING
  CONFIRMED
  FAILED
}

// Phase 8: outcome of a verification attempt (closed contract).
//   VERIFIED      — recomputed content digest matches ProofAnchor.contentHash.
//   TAMPERED      — recomputed digest does NOT match (proof changed post-anchor).
//   NOT_FOUND     — no anchor / no contentHash baseline to compare against.
//   INDETERMINATE — anchored, but the digest can't be computed right now
//                   (a file hash is PENDING/FAILED) — retry.
enum VerificationResult {
  VERIFIED
  TAMPERED
  NOT_FOUND
  INDETERMINATE
}

// Phase 8: strength tier for a VERIFIED result (null for other results).
//   HASH_VERIFIED              — content matches the anchored digest.
//   CRYPTOGRAPHICALLY_VERIFIED — and that anchor is Bitcoin-CONFIRMED.
enum VerificationTier {
  HASH_VERIFIED
  CRYPTOGRAPHICALLY_VERIFIED
}

// ─── Models ───────────────────────────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String
  role             Role
  orgId            String?
  status           String           @default("active")
  subscriptionTier SubscriptionTier @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLoginAt      DateTime?

  org              Organization?     @relation("OrgMembers", fields: [orgId], references: [id])
  ownedOrgs        Organization[]    @relation("OrgOwner")
  sessions         Session[]
  proofsOwned      Proof[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  casesOwned       Case[]
  evidencePackages EvidencePackage[]

  @@index([email])
  @@index([role])
  @@index([orgId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  type        String
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User    @relation("OrgOwner", fields: [ownerUserId], references: [id])
  members User[]  @relation("OrgMembers")
  proofs  Proof[]
  cases   Case[]

  @@index([ownerUserId])
}

// Session.id is the SHA-256(token) hex digest, per lucia-auth.com/sessions/basic.
// The plaintext token is never persisted; it lives only in the user's cookie.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Proof {
  id             String      @id @default(cuid())
  ownerUserId    String
  orgId          String?
  title          String
  description    String      @default("")
  categoryKey    String
  proofType      String
  status         ProofStatus @default(DRAFT)
  visibility     Visibility  @default(PRIVATE)
  eventDate      DateTime?
  peopleInvolved String[]    @default([])
  notes          String?
  locationMode   String?
  manualLocation String?
  roleContext    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sealedAt       DateTime?

  owner                   User                     @relation(fields: [ownerUserId], references: [id])
  org                     Organization?            @relation(fields: [orgId], references: [id])
  files                   ProofFile[]
  attestation             ProofAttestation?
  verifications           VerificationRecord[]
  verificationChainCursor VerificationChainCursor?
  caseLinks               CaseProof[]
  preservation            PreservationConfig?
  anchor                  ProofAnchor?
  evidencePackages        EvidencePackage[]

  @@index([ownerUserId])
  @@index([orgId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([ownerUserId, status])
  @@index([orgId, status])
}

model ProofFile {
  id           String     @id @default(cuid())
  proofId      String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  fileHash     String?
  hashStatus   HashStatus @default(PENDING)
  createdAt    DateTime   @default(now())

  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId])
}

model ProofAttestation {
  id                  String   @id @default(cuid())
  proofId             String   @unique
  attestationName     String
  attestationLocation String
  attestationText     String
  attestationFileId   String?
  createdAt           DateTime @default(now())

  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

// Phase 6: VerificationRecord rows form a per-proof hash chain.
// prevHash/entryHash are populated by lib/verification-chain.ts inside a
// SELECT … FOR UPDATE on VerificationChainCursor (keyed by proofId).
//
// Phase 8: `result` became the VerificationResult enum and `tier` was
// added; the entryHash composition now includes `tier`, so the chain
// commits to it. That format change requires a one-time re-stamp —
// scripts/backfill-verification-result.ts recomputes every entryHash.
model VerificationRecord {
  id               String             @id @default(cuid())
  proofId          String
  method           String
  result           VerificationResult
  tier             VerificationTier?
  requesterContext Json               @default("{}")
  prevHash         String?
  entryHash        String
  createdAt        DateTime           @default(now())

  proof Proof @relation(fields: [proofId], references: [id])

  @@index([proofId])
  @@index([createdAt(sort: Desc)])
  @@index([proofId, createdAt(sort: Desc)])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

model Case {
  id          String   @id @default(cuid())
  ownerUserId String
  orgId       String?
  title       String
  description String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User              @relation(fields: [ownerUserId], references: [id])
  org              Organization?     @relation(fields: [orgId], references: [id])
  proofLinks       CaseProof[]
  evidencePackages EvidencePackage[]

  @@index([ownerUserId])
  @@index([orgId])
  @@index([status])
}

model CaseProof {
  id        String   @id @default(cuid())
  caseId    String
  proofId   String
  createdAt DateTime @default(now())

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@unique([caseId, proofId])
  @@index([caseId])
  @@index([proofId])
}

model EvidencePackage {
  id              String        @id @default(cuid())
  caseId          String?
  proofId         String?
  status          PackageStatus @default(PENDING)
  packageType     String
  createdByUserId String
  storagePath     String?
  createdAt       DateTime      @default(now())

  case      Case?  @relation(fields: [caseId], references: [id])
  proof     Proof? @relation(fields: [proofId], references: [id])
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  @@index([caseId])
  @@index([proofId])
  @@index([createdByUserId])
  @@index([status])
}

// Phase 6: AuditLog rows form a tamper-evident hash chain.
//   prevHash   = entryHash of the previous row (null for the genesis row).
//   entryHash  = sha256(prevHash || actorUserId || entityType || entityId
//                       || action || canonical(meta) || createdAt iso).
//   signature  = HMAC-SHA-256(entryHash) under AUDIT_SIGNING_KEY (lib/audit-sig.ts).
// Inserts go through lib/audit.ts → appendAudit, which serializes via
// SELECT … FOR UPDATE on the global AuditChainCursor row. A BEFORE UPDATE
// trigger (see migration) makes proof.hidden.revealed rows immutable for
// 24 hours — declarative defense in depth; the application path never
// updates audit rows anyway.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  meta        Json     @default("{}")
  prevHash    String?
  entryHash   String
  signature   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// Single-row table (`id = 'global'`) acting as the lock target for the
// audit hash chain. Append-audit transactions SELECT FOR UPDATE this row
// to linearize concurrent writers. lastEntryHash mirrors the current chain
// head for cheap lookup without scanning AuditLog.
//
// Single global cursor is the simplest correct design at current write
// volume. When audit insert rate justifies sharding (~hundreds of rows/sec),
// the swap is a per-shard cursor table + a hashing function from
// (actorUserId, entityType) → shard.
model AuditChainCursor {
  id            String   @id @default("global")
  lastEntryHash String?
  updatedAt     DateTime @updatedAt
}

// Per-proof cursor for the verification record chain. Each proof gets its
// own cursor row so heavy-traffic proofs serialize against themselves only,
// not against unrelated verifies. lastEntryHash mirrors the per-proof chain
// head. Created lazily on first verify; deleted when the proof is deleted
// (cascade).
model VerificationChainCursor {
  proofId       String   @id
  lastEntryHash String?
  updatedAt     DateTime @updatedAt

  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

model PreservationConfig {
  id               String   @id @default(cuid())
  proofId          String   @unique
  preservationMode Boolean  @default(false)
  hiddenVaultMode  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}

// ─── Phase 5: Background jobs ────────────────────────────────────────────
//
// Generic queue row, claimed via Postgres `SELECT … FOR UPDATE SKIP LOCKED`
// inside lib/jobs.ts. payload shape is per-job-type and validated in the
// handler rather than the schema. attempts increments on each claim, and
// terminal failure flips status to FAILED with lastError populated.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  lastError   String?
  runAfter    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, runAfter])
}

// Phase 7: OpenTimestamps anchor.
//   contentHash        — the 32-byte sha256 digest actually submitted to the
//                        calendars (chained AuditLog entries + ProofFile
//                        hashes + ProofAttestation; see lib/ots/proof-digest).
//                        Stored so anchor/verify and the Phase 8 tamper check
//                        don't have to deserialize otsProof. Nullable only
//                        for legacy STUB rows.
//   otsProof           — PENDING: partial proof from POST /digest.
//                        CONFIRMED: full receipt from GET /timestamp/<c>.
//   bitcoinBlockHeight — populated on CONFIRMED from the Bitcoin attestation.
//   bitcoinBlockHash   — populated on CONFIRMED.
//   confirmedAt        — wall-clock of the CONFIRMED transition.
//   upgradedAt         — wall-clock the partial proof was replaced by the
//                        confirmed receipt (== confirmedAt today; separate
//                        column so a future "re-upgrade" path stays clean).
model ProofAnchor {
  id                 String       @id @default(cuid())
  proofId            String       @unique
  contentHash        Bytes?
  otsProof           Bytes
  status             AnchorStatus @default(STUB)
  bitcoinBlockHeight Int?
  bitcoinBlockHash   String?
  anchoredAt         DateTime     @default(now())
  confirmedAt        DateTime?
  upgradedAt         DateTime?

  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
}
